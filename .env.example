DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_JSON_MODE=true
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_REASONING_EFFORT=medium
DEEPSEEK_TRUST_ENV=false

# Pi is the primary operator harness. It is installed project-locally through
# package-lock.json and calls the FastAPI business core through typed tools.
PI_ENABLED=true
PI_PROVIDER=deepseek
PI_MODEL=deepseek-v4-flash
PI_THINKING=low
PI_REQUEST_TIMEOUT_SECONDS=180
XIANYU_API_BASE_URL=http://127.0.0.1:8788
# PI_NODE_PATH=node
# PI_CLI_PATH=E:\闲鱼\xianyu\node_modules\@earendil-works\pi-coding-agent\dist\cli.js
# PI_SESSION_ID=stable-uuid-for-this-project

# stub writes payloads to data/outbox. xianguanjia posts to XIANGUANJIA_* endpoints.
XIANYU_ADAPTER=stub
XIANGUANJIA_BASE_URL=
XIANGUANJIA_TOKEN=
XIANGUANJIA_APP_ID=
XIANGUANJIA_API_KEY=
# Some providers/docs name these as appKey/appSecret. They are aliases for
# XIANGUANJIA_APP_ID / XIANGUANJIA_API_KEY and can be used instead.
# XIANGUANJIA_APP_KEY=
# XIANGUANJIA_APP_SECRET=
XIANGUANJIA_CREATE_ENDPOINT=/api/listings
XIANGUANJIA_POLISH_ENDPOINT=/api/listings/{listing_id}/polish
XIANGUANJIA_FULFILL_ENDPOINT=/api/orders/{order_id}/fulfill

# Feishu CLI long connection: events are bridged to /feishu/events automatically.
# FEISHU_VERIFICATION_TOKEN is optional; used to verify event payloads if configured.
FEISHU_VERIFICATION_TOKEN=

# Image search is reference-only by default. Prefer own/authorized product photos.
IMAGE_SEARCH_PROVIDER=none
SERPAPI_KEY=
BING_SEARCH_KEY=
ALLOW_EXTERNAL_PRODUCT_IMAGES=false

DATA_DIR=data/live
DB_PATH=data/live/xianyu_data.db
POLISH_AT=09:30
SERVER_HOST=127.0.0.1
SERVER_PORT=8788

# GitHub opportunity discovery. Token is optional, but increases API rate limits.
GITHUB_TOKEN=
GITHUB_TRUST_ENV=true
GITHUB_DISCOVERY_ENABLED=true
GITHUB_DISCOVERY_AT=10:30
GITHUB_DISCOVERY_QUERIES=ai agent,agent framework,automation agent,chatbot,workflow automation
GITHUB_DISCOVERY_MIN_STARS=500
GITHUB_DISCOVERY_LIMIT_PER_QUERY=5

# Virtual product opportunity agent.
MARKET_SEARCH_PROVIDER=none
MARKET_SEARCH_LIMIT=5
DEFAULT_PLATFORM_FEE_RATE=0.08
MIN_PROFIT_AMOUNT=20
MIN_PROFIT_RATE=0.30
ASK_FEISHU_ON_OPPORTUNITY=true

# URL crawler for authorized downloadable product sources.
CRAWLER_MAX_PAGES=3
CRAWLER_MAX_DOWNLOADS=5
CRAWLER_MAX_FILE_MB=200

# Platform guard. This pauses automation instead of bypassing risk checks.
PLATFORM_GUARD_ENABLED=true
PLATFORM_GUARD_MIN_SECONDS_BETWEEN_ACTIONS=20
PLATFORM_GUARD_MAX_ACTIONS_PER_HOUR=60
PLATFORM_GUARD_DAILY_ACTION_LIMIT=300
PLATFORM_GUARD_PAUSE_ON_VERIFICATION=true

# Browser execution layer. It uses normal Edge DevTools control and pauses on verification.
BROWSER_EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
BROWSER_DEBUG_PORT=9225
BROWSER_CDP_URL=http://127.0.0.1:9225
BROWSER_USER_DATA_DIR=E:\xianyu-agent-browser-profile
BROWSER_HEADLESS=false

# Deprecated OpenClaw compatibility roots. They are not used by the primary Pi route.
OPENCLAW_ROOT=E:\openclaw\openclaw-main
OPENCLAW_CONTROL_CENTER_ROOT=E:\openclaw-control-center-main\openclaw-control-center-main
OPENCLAW_MISSION_CONTROL_ROOT=E:\openclaw-mission-control-master\openclaw-mission-control-master
OPENCLAW_RL_ROOT=E:\OpenClaw-RL-main\OpenClaw-RL-main
AWESOME_OPENCLAW_SKILLS_ROOT=E:\awesome-openclaw-skills-main\awesome-openclaw-skills-main

# Product discovery: Playwright-based Xianyu search and monitoring.
DISCOVERY_ENABLED=true
DISCOVERY_AT=11:00
DISCOVERY_MAX_PAGES=3
# DISCOVERY_DEFAULT_MIN_PRICE=
# DISCOVERY_DEFAULT_MAX_PRICE=

# Auto-reply: Multi-expert AI customer service bot.
AUTO_REPLY_ENABLED=false
# AUTO_REPLY_MODEL= uses DEEPSEEK_MODEL if empty
AUTO_REPLY_HUMAN_TOGGLE=。

PI_USAGE_RECONCILE_OPERATOR=
PI_USAGE_RECONCILE_TOKEN_SHA256=

# G1A intake use confirmation: trusted local operator channel.
# Generate with: python -c "import hashlib,secrets; print(hashlib.sha256(secrets.token_urlsafe(48).encode()).hexdigest())"
# Leave empty to keep confirmation endpoints disabled (503); job tokens are always rejected.
INTAKE_CONFIRM_OPERATOR=
INTAKE_CONFIRM_TOKEN_SHA256=

# G2A radar dispatcher: opt-in periodic tick inside the single server writer
# process. Manual POST /commerce/radar/tick works regardless of this flag.
RADAR_DISPATCHER_ENABLED=0
# RADAR_DISPATCHER_INTERVAL_SECONDS=60
