{
  "name": "W2-candidate-review",
  "nodes": [
    {
      "parameters": {},
      "name": "Review Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "id": "w2-trigger",
      "notes": "人工触发；负载带 account_id / input_artifact_ids / input_version（快照组）"
    },
    {
      "parameters": {
        "url": "={{$env.XIANYU_API_BASE}}/api/v1/workflow-runs",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ business_intent_id: 'candidate-review:' + $json.account_id + ':' + $json.input_digest + ':v' + $json.input_version, workflow_type: 'candidate_review', account_id: $json.account_id, input_version: $json.input_version, input_artifact_ids: $json.input_artifact_ids, requested_capabilities: ['validate_evidence', 'match_products', 'calculate_economics', 'export_candidates'], orchestration_mode: 'stepwise', orchestration_trace: { engine: 'n8n', execution_id: $execution.id } }) }}",
        "options": {}
      },
      "name": "Create Run (idempotent)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [220, 0],
      "id": "w2-create-run",
      "notes": "幂等键 = candidate-review:account:input-digest:vN；重复触发（重试 execution）返回同一 run"
    },
    {
      "parameters": {
        "url": "={{$env.XIANYU_API_BASE}}/api/v1/workflow-runs/{{$json.run_id}}/steps",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ capability: $json.capability }) }}",
        "options": {}
      },
      "name": "Request Step",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [440, 0],
      "id": "w2-request-step",
      "notes": "被 Capability Loop 逐个喂入能力名；live_step_exists 409 = 该能力已有活步（上次执行中断），直接跳到轮询"
    },
    {
      "parameters": {
        "url": "={{$env.XIANYU_API_BASE}}/api/v1/workflow-runs/{{$('Create Run (idempotent)').item.json.run_id}}",
        "method": "GET",
        "options": {}
      },
      "name": "Poll Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [660, 0],
      "id": "w2-poll",
      "notes": "轮询整个 run：读 steps 数组判断哪些能力已终态"
    },
    {
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      },
      "name": "Wait Before Re-poll",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [660, 140],
      "id": "w2-wait"
    },
    {
      "parameters": {
        "functionCode": "// 从 run 里选出下一个未终态的已请求能力（断点续跑：\n// 中断后重新执行本工作流，已完成的步骤不会被重复请求——\n// 服务端 live_step_exists 409 + 本函数跳过终态步骤双保险）\nconst run = items[0].json;\nconst terminal = new Set(['succeeded', 'failed', 'skipped']);\nconst done = new Set((run.steps || []).filter(s => terminal.has(s.status)).map(s => s.capability));\nconst next = (run.requested_capabilities || []).find(c => !done.has(c));\nreturn [{ json: { run_id: run.run_id, next_capability: next || null, done: [...done] } }];"
      },
      "name": "Next Pending Capability",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [880, 0],
      "id": "w2-next-capability"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{$json.next_capability}}", "value2": "" }
          ],
          "boolean": [
            { "value1": "={{$json.next_capability === null || $json.next_capability === undefined}}", "value2": true }
          ]
        }
      },
      "name": "All Steps Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1100, 0],
      "id": "w2-all-done"
    },
    {
      "parameters": {
        "url": "={{$env.XIANYU_API_BASE}}/api/v1/workflow-runs/{{$('Create Run (idempotent)').item.json.run_id}}/finalize",
        "method": "POST",
        "options": {}
      },
      "name": "Finalize (server judgment)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1320, -60],
      "id": "w2-finalize",
      "notes": "负向研究结论（零候选/无价差）也是成功 finalize——skip 理由由服务端合同校验；required_steps_incomplete 409 继续轮询"
    },
    {
      "parameters": {
        "url": "={{$env.XIANYU_API_BASE}}/api/v1/artifacts/{{$json.manifest.artifact_ids[0]}}",
        "method": "GET",
        "options": {}
      },
      "name": "Fetch Result Artifact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1540, -60],
      "id": "w2-artifact",
      "notes": "manifest 里的产物 id 由服务端生成；这里取第一个作为结果摘要（导出清单/淘汰报告）"
    },
    {
      "parameters": {
        "url": "={{$env.XIANYU_API_BASE}}/api/v1/workflow-runs/{{$('Create Run (idempotent)').item.json.run_id}}/events",
        "method": "GET",
        "options": {}
      },
      "name": "Emit Events Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1760, -60],
      "id": "w2-events"
    },
    {
      "parameters": {
        "url": "={{$env.XIANYU_ERROR_WEBHOOK}}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'W2-candidate-review', run_id: $('Create Run (idempotent)').item.json.run_id, failure: $json.detail, execution_id: $execution.id }) }}",
        "options": {}
      },
      "name": "Error Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1320, 160],
      "id": "w2-error-queue"
    }
  ],
  "connections": {
    "Review Trigger": { "main": [[{ "node": "Create Run (idempotent)", "type": "main", "index": 0 }]] },
    "Create Run (idempotent)": { "main": [[{ "node": "Poll Run", "type": "main", "index": 0 }]] },
    "Poll Run": { "main": [[{ "node": "Next Pending Capability", "type": "main", "index": 0 }]] },
    "Next Pending Capability": { "main": [[{ "node": "All Steps Done?", "type": "main", "index": 0 }]] },
    "All Steps Done?": { "main": [
      [{ "node": "Finalize (server judgment)", "type": "main", "index": 0 }],
      [{ "node": "Request Step", "type": "main", "index": 0 }]
    ]},
    "Request Step": { "main": [[{ "node": "Wait Before Re-poll", "type": "main", "index": 0 }]] },
    "Wait Before Re-poll": { "main": [[{ "node": "Poll Run", "type": "main", "index": 0 }]] },
    "Finalize (server judgment)": { "main": [[{ "node": "Fetch Result Artifact", "type": "main", "index": 0 }]] },
    "Fetch Result Artifact": { "main": [[{ "node": "Emit Events Summary", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "W2-candidate-review Error Queue"
  },
  "staticData": null,
  "meta": {
    "instanceId": "not-exported",
    "description": "R18 W2 候选评审链（合同 11 §4 示例的落地）：幂等建 run -> 断点续跑循环（跳过已终态步骤）-> 服务端 finalize -> 取 manifest 产物 -> 事件摘要。negative research（零候选/淘汰）是合法成功；跳步理由服务端校验。credentials 不导出。"
  },
  "tags": [{ "name": "xianyu" }, { "name": "W2" }, { "name": "offline-first" }]
}
