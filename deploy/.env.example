# R16 deployment profile — copy to deploy/.env and adjust.
# NEVER put real credentials in this file or in the image; production
# secrets are injected at runtime (env / secret store), never baked.

# loopback by default; set 0.0.0.0 only on a trusted LAN
XIANYU_BIND=127.0.0.1

# stub adapter in the offline profile; a real adapter requires the
# authorized browser-channel profile (R30)
XIANYU_ADAPTER=stub

# offline isolation ON by default; production turns it off explicitly
XIANYU_TEST_ISOLATION=1

# local operator mode ON = loopback UI works without tokens (R03);
# strict mode (off) requires XIANYU_AUTH_TOKENS
XIANYU_AUTH_LOCAL_OPERATOR=1
